# TMDB - https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_or_v4_token_here

# TVmaze nema API key (public API), koristi se samo za serije (ne za filmove)

# Region za streaming dostupnost (ISO 3166-1)
DEFAULT_REGION=RS

# Vremenska zona za prikaz datuma/vremena
DEFAULT_TIMEZONE=Europe/Belgrade

# Putanja do SQLite baze
DATABASE_URL=sqlite+aiosqlite:///./data/tracker.db

# Log level
LOG_LEVEL=INFO

# Cache TTL za API pozive (sekunde)
CACHE_TTL_SECONDS=3600
